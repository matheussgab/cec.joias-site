# Copie para .env e ajuste.

# Banco (servidor dedicado). Em produção use sslmode=require ou rede privada/VPN entre os servidores.
DATABASE_URL=postgres://cec:cec@127.0.0.1:5433/cec

# A API escuta só localmente; o nginx publica na internet com HTTPS.
HOST=127.0.0.1
PORT=3000

# Endereço público do site (usado nas prévias de link do WhatsApp).
PUBLIC_URL=http://localhost:3000

# Em produção:
# NODE_ENV=production
# TRUST_PROXY=1
# PUBLIC_URL=https://cecjoias.ma24.com
# UPLOADS_DIR=/var/lib/cec-joias/uploads

# Fotos no Supabase Storage (obrigatório na Vercel, que não tem disco permanente).
# Sem estas variáveis as fotos ficam em disco (UPLOADS_DIR). O bucket é criado pelo `npm run migrate`.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=fotos
